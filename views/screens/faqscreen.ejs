<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    
    <title>FAQ Management | Omni AI</title>

    <link rel="stylesheet" href="/stylesheets/faq-management.css">

    <!-- FONT AWESOME -->
    <link 
        rel="stylesheet" 
        href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css"
    >
</head>

<body>

<div class="dashboard">

    <!-- SIDEBAR -->
    <aside class="sidebar">

        <div class="logo">
            <h1>LCRP</h1>
        </div>

        <nav>

            <a href="/dashboard">
                Dashboard
            </a>

            <a href="/user/leed">
                Leads
            </a>

            <a href="/user/faq-management" class="active">
                FAQ Management
            </a>

            <a href="/chat">
                AI Chat
            </a>

            <a href="/logout">
                Logout
            </a>

        </nav>

    </aside>

    <!-- MAIN CONTENT -->
    <div class="content">

        <header class="page-header">

            <div>

                <span class="badge">
                    AI Training Center
                </span>

                <h1>
                    FAQ Management
                </h1>

                <p>
                    Train your AI assistant with accurate business information.
                    The more FAQs you create, the smarter your assistant becomes.
                </p>

            </div>

        </header>

        <!-- FLASH -->
        <div class="flash-wrapper">

            <%- include('../component/flashmessage') %>

        </div>

        <!-- MAIN GRID -->
        <main class="faq-container">

            <!-- CREATE FAQ -->
            <section class="createFAQ">

                <div class="card-header">

                    <h2>
                        Create New FAQ
                    </h2>

                    <p>
                        Add knowledge that your AI assistant can use when responding to customers.
                    </p>

                </div>

                <form
                    action="/FAQ/"
                    method="post"
                >

                    <input
                        type="text"
                        name="question"
                        placeholder="Enter Question"
                        required
                    >

                    <textarea
                        name="answer"
                        placeholder="Enter Answer"
                        required
                    ></textarea>

                    <button type="submit">
                        Create FAQ
                    </button>

                </form>

            </section>

            <!-- FAQ LIST -->
            <section class="FAQs">

                <div class="card-header">

                    <h2>
                        Knowledge Base
                    </h2>

                    <p>
                        Manage your existing FAQs.
                    </p>

                </div>

                <div
                    id="faqList"
                    class="faq-list"
                >

                </div>

            </section>

        </main>

    </div>

</div>

<!-- UPDATE MODAL -->
<div
    class="modal-overlay"
    id="modalOverlay"
>

    <div class="update-modal">

        <h2>
            Update FAQ
        </h2>

        <form id="updateFaqForm">

            <input
                type="hidden"
                id="updateId"
            >

            <input
                type="text"
                id="updateQuestion"
                placeholder="Question"
                required
            >

            <textarea
                id="updateAnswer"
                placeholder="Answer"
                required
            ></textarea>

            <div class="modal-buttons">

                <button type="submit">
                    Update FAQ
                </button>

                <button
                    type="button"
                    id="closeModal"
                    class="cancel-btn"
                >
                    Cancel
                </button>

            </div>

        </form>

    </div>

</div>

<!-- KEEP YOUR EXISTING SCRIPT EXACTLY AS IT IS -->
<script>

    const faqList =
        document.getElementById("faqList");

    const modalOverlay =
        document.getElementById("modalOverlay");

    const updateFaqForm =
        document.getElementById("updateFaqForm");

    const closeModal =
        document.getElementById("closeModal");

    // LOAD FAQS

    async function loadFAQs(){

        try{

            const response = await fetch(
                "http://127.0.0.1:8000/FAQ/"
            );

            const result = await response.json();

            console.log(result);

            const faqs = result.data;

            faqList.innerHTML = "";

            // EMPTY STATE

            if(faqs.length === 0){

                faqList.innerHTML = `
                
                    <div class="empty-state">

                        <h3>
                            No FAQ Created Yet
                        </h3>

                        <p>
                            Create your first FAQ
                            to train Omni AI.
                        </p>

                    </div>
                
                `;

                return;
            }

            // DISPLAY FAQS

            faqs.forEach((faq)=>{

                faqList.innerHTML += `
                
                    <div class="faq-card">

                        <div class="faq-content">

                            <h3>
                                ${faq.question}
                            </h3>

                            <p>
                                ${faq.answer}
                            </p>

                        </div>

                        <div class="faq-actions">

                            <!-- EDIT -->
                            <button 
                                class="edit-btn"

                                onclick="openUpdateModal(
                                    '${faq._id}',
                                    \`${faq.question}\`,
                                    \`${faq.answer}\`
                                )"
                            >

                                <i class="fa-solid fa-pen"></i>

                            </button>

                            <!-- DELETE -->
                            <button 
                                class="delete-btn"

                                onclick="deleteFAQ(
                                    '${faq._id}'
                                )"
                            >

                                <i class="fa-solid fa-trash"></i>

                            </button>

                        </div>

                    </div>
                
                `;

            });

        }catch(err){

            console.log(err);

        }

    }

    loadFAQs();

    // DELETE FAQ

    async function deleteFAQ(id){

        const confirmDelete = confirm(
            "Delete this FAQ?"
        );

        if(!confirmDelete){
            return;
        }

        try{

            await fetch(
                `http://127.0.0.1:8000/FAQ/${id}`,
                {
                    method:"DELETE"
                }
            );

            loadFAQs();

        }catch(err){

            console.log(err);

        }

    }

    // OPEN UPDATE MODAL

    function openUpdateModal(
        id,
        question,
        answer
    ){

        modalOverlay.classList.add("active");

        document.getElementById(
            "updateId"
        ).value = id;

        document.getElementById(
            "updateQuestion"
        ).value = question;

        document.getElementById(
            "updateAnswer"
        ).value = answer;

    }

    // CLOSE MODAL

    closeModal.addEventListener(
        "click",
        ()=>{

            modalOverlay.classList.remove(
                "active"
            );

        }
    );

    // UPDATE FAQ

    updateFaqForm.addEventListener(
        "submit",

        async (e)=>{

            e.preventDefault();

            const data = {

                recordid:
                    document.getElementById(
                        "updateId"
                    ).value,

                question:
                    document.getElementById(
                        "updateQuestion"
                    ).value,

                answer:
                    document.getElementById(
                        "updateAnswer"
                    ).value

            };

            try{

                await fetch(
                    "http://127.0.0.1:8000/FAQ/",

                    {
                        method:"PUT",

                        headers:{
                            "Content-Type":
                                "application/json"
                        },

                        body: JSON.stringify(data)
                    }
                );

                modalOverlay.classList.remove(
                    "active"
                );

                loadFAQs();

            }catch(err){

                console.log(err);

            }

        }
    );

</script>

</body>
</html>