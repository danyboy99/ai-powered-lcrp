<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>LCRP | AI Lead Recovery Platform</title>
    <link rel="stylesheet" href="/stylesheets/index.css">
</head>
<body>

    <header class="navbar">
        <div class="logo">
            <h1>LCRP</h1>
        </div>

        <nav>
            <a href="#about">About</a>
            <a href="/user/login" class="btn-secondary">Login</a>
            <a href="/user/signup" class="btn-primary">Sign Up</a>
        </nav>
    </header>

    <section class="hero">

        <div class="hero-content">
            <span class="badge">AI-Powered Lead Recovery</span>

            <h2>
                Turn Missed Calls Into
                <span>Paying Customers</span>
            </h2>

            <p>
                LCRP helps trades businesses automatically recover missed
                calls, capture customer enquiries, track follow-ups,
                and use AI to improve lead conversion rates.
            </p>

            <div class="hero-buttons">
                <a href="/signup" class="btn-primary">
                    Get Started
                </a>

                <a href="#about" class="btn-outline">
                    Learn More
                </a>
            </div>
        </div>

    </section>

    <section id="about" class="features">

        <h3>Everything You Need To Recover More Leads</h3>

        <div class="feature-grid">

            <div class="card">
                <h4>📞 Missed Call Recovery</h4>
                <p>
                    Automatically send SMS responses when calls are missed.
                </p>
            </div>

            <div class="card">
                <h4>📋 Lead Capture</h4>
                <p>
                    Store customer details and enquiries in a centralized system.
                </p>
            </div>

            <div class="card">
                <h4>📈 Lead Tracking</h4>
                <p>
                    Track leads from first contact to completed job.
                </p>
            </div>

            <div class="card">
                <h4>🤖 AI Assistant</h4>
                <p>
                    Generate summaries, suggested responses, and business insights.
                </p>
            </div>

            <div class="card">
                <h4>📊 Reports</h4>
                <p>
                    Monitor performance through automated weekly reports.
                </p>
            </div>

            <div class="card">
                <h4>⚡ Real-Time Dashboard</h4>
                <p>
                    View new leads, won jobs, lost opportunities, and conversions.
                </p>
            </div>

        </div>
    </section>

    <section class="cta">

        <h3>Stop Losing Customers To Missed Calls</h3>

        <p>
            Empower your business with AI-driven lead recovery and customer engagement.
        </p>

        <a href="/signup" class="btn-primary">
            Start Free
        </a>

    </section>

</body>
</html>